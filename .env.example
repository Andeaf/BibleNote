# Copy this file to .env.local (ignored by git) for local development.
#
# Only the project URL and the publishable (anon) key belong in the frontend: both are public by
# design, and every request is authorised server-side by row-level security.
# The secret / service_role key must never appear in this repository, in Vercel or in the app.

# Supabase → Project Settings → Data API → Project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=

# Supabase → Project Settings → API Keys → publishable key (sb_publishable_…), or the legacy anon key
VITE_SUPABASE_PUBLISHABLE_KEY=

# The security test (`npm run test:rls`) reads a separate, also ignored file, .env.test.local:
#   SUPABASE_URL=https://<ref>.supabase.co
#   SUPABASE_ANON_KEY=<publishable key>
#   SUPABASE_SERVICE_ROLE_KEY=<secret key, local use only>
